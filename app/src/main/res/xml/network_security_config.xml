<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Deny-by-default: no cleartext; version checks and APK downloads must use HTTPS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
